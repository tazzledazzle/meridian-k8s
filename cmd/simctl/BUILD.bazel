load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "simctl_lib",
    srcs = ["main.go"],
    importpath = "github.com/tazzledazzle/meridian/cmd/simctl",
    visibility = ["//visibility:private"],
    deps = ["//internal/simctl"],
)

go_binary(
    name = "simctl",
    embed = [":simctl_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "simctl_test",
    srcs = ["adversarial_test.go"],
    embed = [":simctl_lib"],
    deps = [
        "//internal/awsapi",
        "//internal/fakeec2",
    ],
    data = ["//:go_tree"],
    tags = ["local", "no-sandbox"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
