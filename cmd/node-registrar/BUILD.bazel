load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "node-registrar_lib",
    srcs = ["main.go"],
    importpath = "github.com/tazzledazzle/meridian/cmd/node-registrar",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/catalog",
        "//internal/noderegistrar",
    ],
)

go_binary(
    name = "node-registrar",
    embed = [":node-registrar_lib"],
    visibility = ["//visibility:public"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
