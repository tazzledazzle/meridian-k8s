load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pricing-facade_lib",
    srcs = ["main.go"],
    importpath = "github.com/tazzledazzle/meridian/cmd/pricing-facade",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/gateway",
        "//internal/pricingfacade",
    ],
)

go_binary(
    name = "pricing-facade",
    embed = [":pricing-facade_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "pricing-facade_test",
    srcs = [
        "adversarial_test.go",
        "main_test.go",
    ],
    embed = [":pricing-facade_lib"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
