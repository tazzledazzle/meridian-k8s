load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gatecheck",
    srcs = [
        "interruption.go",
        "network.go",
        "noroute.go",
    ],
    importpath = "github.com/tazzledazzle/meridian/internal/gatecheck",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "gatecheck_test",
    srcs = [
        "adversarial_test.go",
        "interruption_test.go",
        "network_test.go",
        "noroute_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gatecheck"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
