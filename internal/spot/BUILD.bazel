load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "spot",
    srcs = ["spot.go"],
    importpath = "github.com/tazzledazzle/meridian/internal/spot",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/awsapi",
        "//internal/awscall",
    ],
)

go_test(
    name = "spot_test",
    srcs = [
        "adversarial_test.go",
        "event_test.go",
        "fuzz2_test.go",
        "fuzz_test.go",
        "gateway_test.go",
        "spot_test.go",
    ],
    data = glob(["testdata/**"]) + ["//:ops.yaml"],
    embed = [":spot"],
    deps = [
        "//internal/awsapi",
        "//internal/fakeec2",
        "//internal/gateway",
        "//internal/ops",
    ],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
