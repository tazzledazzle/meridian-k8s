load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ops",
    srcs = [
        "load.go",
        "ops.go",
    ],
    importpath = "github.com/tazzledazzle/meridian/internal/ops",
    visibility = ["//:__subpackages__"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "ops_test",
    srcs = ["ops_test.go"],
    embed = [":ops"],
    data = ["//:ops.yaml"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
