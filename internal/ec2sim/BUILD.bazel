load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ec2sim",
    srcs = ["ec2sim.go"],
    importpath = "github.com/tazzledazzle/meridian/internal/ec2sim",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/awsapi",
        "//internal/catalog",
