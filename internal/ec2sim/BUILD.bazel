)

go_test(
    name = "ec2sim_test",
    srcs = [
        "adversarial_test.go",
        "ec2sim_test.go",
        "filter_test.go",
        "fuzz2_test.go",
        "fuzz_test.go",
        "integration_test.go",
        "page_test.go",
    ],
    embed = [":ec2sim"],
    deps = [
        "//internal/awscall",
        "//internal/catalog",
        "//internal/gateway",
        "//internal/noderegistrar",
        "//internal/ops",
        "//internal/s0probe",
    ],
