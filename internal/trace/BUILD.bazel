load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "trace",
    srcs = ["trace.go"],
    importpath = "github.com/tazzledazzle/meridian/internal/trace",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "trace_test",
    srcs = [
        "adversarial_test.go",
        "fuzz_test.go",
        "trace_test.go",
    ],
    embed = [":trace"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
