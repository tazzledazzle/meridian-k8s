load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "simctl",
    srcs = ["simctl.go"],
    importpath = "github.com/tazzledazzle/meridian/internal/simctl",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/catalog",
        "//internal/spot",
    ],
)

go_test(
    name = "simctl_test",
    srcs = [
        "adversarial_test.go",
        "simctl_test.go",
    ],
    embed = [":simctl"],
    deps = [
        "//internal/awsapi",
        "//internal/fakeec2",
    ],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
