load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "versions",
    srcs = [
        "env.go",
        "load.go",
        "modulepins.go",
        "versions.go",
    ],
    importpath = "github.com/tazzledazzle/meridian/internal/versions",
    visibility = ["//:__subpackages__"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "versions_test",
    srcs = [
        "adversarial_test.go",
        "env_test.go",
        "modulepins_test.go",
        "modulepins_tester_test.go",
        "versions_test.go",
    ],
    data = [
        "//:MODULE.bazel",
        "//:versions.yaml",
    ],
    embed = [":versions"],
)

# `make lint-versions`: versions.yaml fully pinned, and MODULE.bazel's repeated pins equal to it.
go_test(
    name = "lint_versions_test",
    srcs = glob(["*_test.go"]),
    args = ["-test.run=TestRepoVersionsFileIsValid|TestRepoModuleBazelPinsMatchVersionsYaml"],
    data = [
        "//:MODULE.bazel",
        "//:versions.yaml",
    ],
    embed = [":versions"],
    visibility = ["//visibility:public"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
