load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "versions",
    srcs = [
        "env.go",
        "load.go",
        "versions.go",
    ],
    importpath = "github.com/tazzledazzle/meridian/internal/versions",
    visibility = ["//:__subpackages__"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "versions_test",
    srcs = [
        "adversarial_test.go",
        "env_test.go",
        "versions_test.go",
    ],
    embed = [":versions"],
    data = ["//:versions.yaml"],
)

# Plain sources, for the tests that run `go build` / `make` in a copy of the tree.
filegroup(
    name = "gosrcs",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)
