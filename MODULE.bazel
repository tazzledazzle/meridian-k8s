"""Meridian build. versions.yaml stays the single source of pins; the few literals that
bzlmod forces us to repeat here (Go SDK, distroless base digest) are checked against it by
internal/versions TestModuleBazelPinsMatchVersionsYaml (run by `bazel test //:lint_versions`)."""

module(name = "meridian")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_go", version = "0.64.2", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

# --- Go ---
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.13")  # == versions.yaml golang (checked by test)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
# gazelle/rules_go pull golang.org/x/sync v0.22.0, which needs Go >= 1.25; our SDK is the pinned 1.24.13.
go_deps.archive_override(
    path = "golang.org/x/sync",
    sha256 = "8b19a2aa2162ec8fa1cba4762eb06b089ef8d2dbddf4e64ef51334e722b83a7f",
    strip_prefix = "golang.org/x/sync@v0.14.0",
    urls = ["https://proxy.golang.org/golang.org/x/sync/@v/v0.14.0.zip"],
)
go_deps.archive_override(
    path = "golang.org/x/mod",
    sha256 = "1a8ef77bb4d41c1a7d3fa5d0caf2fe599f14eac10f473629e31546f12759b89f",
    strip_prefix = "golang.org/x/mod@v0.24.0",
    urls = ["https://proxy.golang.org/golang.org/x/mod/@v/v0.24.0.zip"],
)
go_deps.archive_override(
    path = "golang.org/x/sys",
    sha256 = "182df79c87135f6dbd0d45656b6527e9221e28899ee44cc6cc7e7a396aedaef9",
    strip_prefix = "golang.org/x/sys@v0.33.0",
    urls = ["https://proxy.golang.org/golang.org/x/sys/@v/v0.33.0.zip"],
)
go_deps.archive_override(
    path = "golang.org/x/tools",
    sha256 = "da7a76d9db0956f30dd7f9957eead7aab5aa132dbca78a6d578436f94fdfee84",
    strip_prefix = "golang.org/x/tools@v0.33.0",
    urls = ["https://proxy.golang.org/golang.org/x/tools/@v/v0.33.0.zip"],
)
use_repo(go_deps, "in_gopkg_yaml_v3")

# --- Python (hermetic) ---
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# --- Images: distroless static, pinned by digest (== versions.yaml static, checked by test) ---
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab",
    image = "gcr.io/distroless/static-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64", "distroless_static_linux_arm64_v8")
